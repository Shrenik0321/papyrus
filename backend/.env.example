# Local development: copy to .env and use with npm run start:dev (DATABASE_HOST=localhost).
# Dev Postgres + bootstrap: ../docker-compose.yml (from fullstack: docker compose up -d --build).
# Production preview overrides (DATABASE_HOST=db, etc.): ../docker-compose.prod.yml

PORT=8000

# OpenAPI / Swagger UI at http://localhost:8000/docs (enabled in dev; off when NODE_ENV=production)
# SWAGGER_ENABLED=false
# SWAGGER_ENABLED=true

# Better Auth — generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-use-openssl-rand-base64-32
# Public app URL (same as CORS_ORIGIN). OAuth redirects + cookies use this origin via Next /api rewrites.
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Google OAuth (redirect URI: {BETTER_AUTH_URL}/api/oauth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Hybrid JWT (access cookie authToken + refresh cookie refreshToken)
JWT_ACCESS_SECRET=change-me-use-openssl-rand-base64-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=papyrus
DATABASE_SYNCHRONIZE=false
RUN_SEEDS=false

# File storage (local dev: files on disk, served at /files)
FILE_STORAGE_DRIVER=local
FILE_STORAGE_ROOT=files
FILE_STORAGE_PUBLIC_BASE_URL=http://localhost:8000/files
