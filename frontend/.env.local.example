# Copy to .env.local for local development (npm run dev on your machine).
# Same-origin `/api` is proxied to Nest via next.config rewrites (see API_ORIGIN).
# NEXT_PUBLIC_API_URL=/api

# Upstream API for rewrites (defaults to http://localhost:8000)
API_ORIGIN=http://localhost:8000

# Server-only (proxy.ts JWT verification) — same value as backend JWT_ACCESS_SECRET
JWT_ACCESS_SECRET=change-me-use-openssl-rand-base64-32
